# ══════════════════════════════════════════════════════════════
#  PocketAgent .gitignore
# ══════════════════════════════════════════════════════════════

# ── 构建产物 ──────────────────────────────────────────────────
.gradle/
build/
*/build/
out/
*.apk
*.aab
*.ap_
*.dex
*.class
release/
captures/
.cxx/

# ── 本地配置（含 SDK 路径，不应共享）─────────────────────────
local.properties
gradle.properties.bak

# ── IDE ──────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.hprof

# ── 操作系统 ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ══════════════════════════════════════════════════════════════
#  ⚠️ 以下为安全相关，**绝对不能提交**
# ══════════════════════════════════════════════════════════════

# ── 签名密钥：丢失可恢复，泄露则灾难 ─────────────────────────
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# ── 任何形式的凭据 ───────────────────────────────────────────
*.token
credentials.json
secrets.properties
.env
.env.*

# ── 屏幕快照 fixture（含真实用户界面内容，严禁入库）──────────
#    方案文档 7.2 节明确要求：快照必须脱敏后才可提交
snapshots/
fixtures/real/
*.snapshot.json
screen-dumps/

# ── 用户数据导出 ─────────────────────────────────────────────
*.pagent
dump/
data-export/

# ── 本工具的会话与记忆数据（非项目产物）─────────────────────
.workbuddy-ai/
