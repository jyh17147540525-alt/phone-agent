# ══════════════════════════════════════════════════════════════
#  PocketAgent .gitignore
# ══════════════════════════════════════════════════════════════

# ── 构建产物 ──────────────────────────────────────────────────
.gradle/
build/
*/build/
# Kotlin 编译器的会话与错误日志（`.kotlin/sessions`、`.kotlin/errors`）。
# 纯本机状态，含时间戳文件名与绝对路径，换台机器毫无意义。
.kotlin/
out/
*.apk
*.aab
*.ap_
*.dex
*.class
release/
captures/
.cxx/

# ── Room / SQLite 测试留下的临时文件 ──────────────────────────
# ⚠️ 这几条防的是「测试用数据库被误提交」，更重要的是**提醒它们的存在**。
#
# `MigrationTestHelper` 的 `File` 参数若是**相对路径**，会按测试进程的工作
# 目录解析并留下文件 —— 实测曾把 `migration-test.db`（含 `user_version = 2`
# 和真实表结构）甩在 `android/core/database/` 下，还会甩一个 `.lck`。
#
# 后果不止是脏：那个文件**跨运行留存**，下一次 `createDatabase(1)` 会打开
# 它、发现是 v2、于是尝试「2 → 1」迁移并抛
# `IllegalStateException: A migration from 2 to 1 was required but not found`
# —— 把排查带偏到"生产代码漏了迁移"上去。
#
# 现在的测试已改用系统临时目录下的 UUID 路径（不会落在源码树里），
# 这几条是**兜底**：万一以后有人又写成相对路径，至少不会误提交一个
# 装着用户数据的数据库文件。
*.db
*.db-journal
*.db-wal
*.db-shm
*.lck
# ⚠️ 例外：Room 导出的 schema JSON **必须入库**（写迁移的唯一依据），
#    所以不能笼统忽略 schemas/ 目录。上面那几条只针对 .db/.lck，安全。
!**/schemas/**

# 被文件锁卡住的构建中间产物暂存区。
# ⚠️ Windows 上 dexBuilder 偶尔会因句柄延迟释放而报 AccessDeniedException，
#    而 tasklist 里根本找不到占用进程。处置方式是把受影响的目录**移**到这里
#    （不是删），让 Gradle 重建 —— 遵循本项目"需要删除时改写成移动"的约定。
#    正常情况下它就是个垃圾桶，但别删它：万一需要取证还在里面。
.build-trash/

# ── 本地配置（含 SDK 路径，不应共享）─────────────────────────
local.properties
gradle.properties.bak

# ── IDE ──────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.hprof

# ── 操作系统 ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ── Python（tools/ 下的一次性脚本与工具）─────────────────────
# 字节码缓存里嵌了源码的绝对路径与 mtime，换台机器必然过期。
# 它还会在 git status 里刷出一大片噪音，把真正的改动淹掉。
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ══════════════════════════════════════════════════════════════
#  ⚠️ 以下为安全相关，**绝对不能提交**
# ══════════════════════════════════════════════════════════════

# ── 签名密钥：丢失可恢复，泄露则灾难 ─────────────────────────
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# ── 任何形式的凭据 ───────────────────────────────────────────
*.token
credentials.json
secrets.properties
.env
.env.*

# ── 屏幕快照 fixture（含真实用户界面内容，严禁入库）──────────
#    方案文档 7.2 节明确要求：快照必须脱敏后才可提交
snapshots/
fixtures/real/
*.snapshot.json
screen-dumps/

# ── 用户数据导出 ─────────────────────────────────────────────
*.pagent
dump/
data-export/

# ⚠️ 上面那条 `*.pagent` 防的是「用户导出的插件包被误提交」，
#    但社区源里打包好的示例插件**必须入库** ——
#    GitHub Pages 是直接从这个目录提供文件的，产物不入库等于源是空的，
#    而空源的直接后果就是用户装好应用打开市场看到「加载失败」。
!community-source/site/plugins/*.pagent

# ── 本工具的会话与记忆数据（非项目产物）─────────────────────
.workbuddy-ai/
